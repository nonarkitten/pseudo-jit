10 REM ERATOSTHENES SIEVE, TINY BASIC VERSION OF SIEVE.BAS (1000 FLAGS)
20 LET S=1000
30 FOR I=0 TO S
40 LET @(I)=1
50 NEXT I
60 LET C=0
70 FOR I=0 TO S
80 IF @(I)=0 GOTO 150
90 LET P=I+I+3
100 LET K=I+P
110 IF K>S GOTO 140
120 LET @(K)=0
130 LET K=K+P
135 GOTO 110
140 LET C=C+1
150 NEXT I
160 PRINT C
RUN

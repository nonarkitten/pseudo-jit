10 REM ERATOSTHENES SIEVE PRIME NUMBER PROGRAM
20 SIZE = 8190
30 DIM FLAGS(8191)
40 PRINT "START"
50 FOR I = 1 TO 1
60   COUNT = 0
70   FOR I = 0 TO SIZE
80     FLAGS(I) = 1
90   NEXT I
100  FOR I = 0 TO SIZE
110    IF FLAGS(I) = 0 THEN GOTO 180
120    PRIME = I + I + 3
130    K = I + PRIME
140    IF K > SIZE THEN GOTO 170
150    FLAGS(K) = 0
160    K = K + PRIME : GOTO 140
170    COUNT = COUNT + 1
180  NEXT I
190 NEXT I
200 PRINT "DONE: "; COUNT; " PRIMES"
210 END